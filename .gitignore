# Python
python/.venv/
python/venv/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Local state of the Selenium harness: browser profile, personal config, recon dumps
python/.chrome-profile/
python/config.local.json
*.local.json
python/recon/
python/recon
python/recon*/

# Node
extension/test/node_modules/
node_modules/
package-lock.json
# extension/test/package-lock.json is tracked (the release workflow runs `npm ci`
# against it); the bare rule above would otherwise ignore it in every directory.
!extension/test/package-lock.json

# Build output
dist/

# Agent tooling (skills installed with `npx skills add`, agent worktrees,
# local agent settings): never part of the extension, never tracked
.agents/
.claude/
skills-lock.json

# Editors, OS, environment
.DS_Store
Thumbs.db
*.log
*.swp
.env
.env.*
.idea/
.vscode/
